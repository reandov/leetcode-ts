{
  "name": "dsa-ts",
  "version": "1.0.0",
  "description": "TypeScript data structures, algorithms, theory notes, and coding problem practice.",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "new-algorithm": "tsx scripts/new-algorithm.ts",
    "new-custom-problem": "tsx scripts/new-custom-problem.ts",
    "new-data-structure": "tsx scripts/new-data-structure.ts",
    "new-leetcode": "tsx scripts/new-problem.ts",
    "new-problem": "tsx scripts/new-problem.ts",
    "new-theory": "tsx scripts/new-theory.ts",
    "run": "tsx",
    "solve": "tsx",
    "test": "tsx --test \"**/*.spec.ts\"",
    "test:watch": "tsx --test --watch \"**/*.spec.ts\"",
    "clean": "rm -rf dist build coverage *.tsbuildinfo"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
